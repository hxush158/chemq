# cp .env.example .env 后填写。.env 已在 .gitignore 里，不要提交。
CHEMQ_ANTHROPIC_API_KEY=sk-ant-...

CHEMQ_PG_DSN=postgresql://chemq_app:chemq@localhost:5432/chemq
CHEMQ_PG_DSN_READONLY=postgresql://chemq_ro_login:chemq@localhost:5432/chemq

# 模型分级：便宜的做分类，贵的做生成。W1 会让你亲眼看到这个选择值多少钱
CHEMQ_MODEL_ROUTER=claude-haiku-4-5-20251001
CHEMQ_MODEL_SQL=claude-sonnet-5
CHEMQ_MODEL_CRITIC=claude-sonnet-5

# W5 才用得上
CHEMQ_AWS_REGION=ap-southeast-2
CHEMQ_S3_KB_BUCKET=
